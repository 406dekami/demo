# ===========================================
# 后端服务环境变量配置示例
# 复制此文件为 .env 并修改相应的配置值
# ===========================================

# -------------------------------------------
# DashScope API Key (必需)
# 用于通义千问模型调用（Embedding、生成等）
# 获取地址：https://dashscope.console.aliyun.com/
# -------------------------------------------
DASHSCOPE_API_KEY=sk-your-api-key-here

# -------------------------------------------
# Redis 配置 (可选，用于缓存知识图谱查询结果)
# -------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------------------------------
# Neo4j 配置 (可选，用于知识图谱存储)
# -------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# -------------------------------------------
# 数据存储路径配置
# 相对路径基于 backend 目录
# -------------------------------------------

# 应用数据目录（用户上传文件等）
APP_DATA_DIR=app/data

# 存储目录（数据库、向量库等）
STORAGE_DIR=storage

# 日志目录
LOG_DIR=logs

# -------------------------------------------
# 数据库配置
# 路径相对于 STORAGE_DIR
# -------------------------------------------

# SQLite 数据库路径
DATABASE_PATH=sqlite/demo.db

# -------------------------------------------
# 向量数据库配置
# 路径相对于 STORAGE_DIR
# -------------------------------------------

# ChromaDB 向量库路径
CHROMA_PERSIST_DIRECTORY=chroma_db

# -------------------------------------------
# 日志配置
# -------------------------------------------

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -------------------------------------------
# CORS 配置
# 生产环境应限制具体域名
# -------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -------------------------------------------
# 数据初始化配置
# -------------------------------------------

# 启动时自动初始化种子数据（思维导图、知识图谱）
AUTO_INIT_SEED_DATA=true

# 强制重新初始化（清空现有数据后重新导入）
FORCE_REINIT=false
